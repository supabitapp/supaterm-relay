[Unit]
Description=Supaterm WebSocket relay
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/supaterm-relay
Environment=RELAY_ADDR=127.0.0.1:8080
Environment=RELAY_PRIVATE_ADDR=127.0.0.1:9090
Environment=RELAY_TRUSTED_PROXIES=127.0.0.1/32
Environment=GOMEMLIMIT=1GiB
Restart=always
RestartSec=2
TimeoutStopSec=15
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
LimitNOFILE=131072
MemoryMax=1536M

[Install]
WantedBy=multi-user.target
