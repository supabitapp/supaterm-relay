[Unit]
Description=Supaterm push gateway
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/supaterm-push
EnvironmentFile=/etc/supaterm-push/push.env
Environment=GOMEMLIMIT=192MiB
Environment=PUSH_ADDR=127.0.0.1:8000
Environment=PUSH_DATABASE=/var/lib/supaterm-push/push.sqlite
Environment=APNS_SANDBOX_KEY_FILE=%d/apns-sandbox.p8
Environment=APNS_PRODUCTION_KEY_FILE=%d/apns-production.p8
LoadCredential=apns-sandbox.p8:/etc/supaterm-push/apns-sandbox.p8
LoadCredential=apns-production.p8:/etc/supaterm-push/apns-production.p8
StateDirectory=supaterm-push
Restart=always
RestartSec=2
TimeoutStopSec=20
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
MemoryMax=256M

[Install]
WantedBy=multi-user.target
